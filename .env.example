APP_NAME="Cakra Krisna Manggala"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://cakrakrisnamanggala.test

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cakrakrisnamanggala
